    {
      "id": "ot-release-2606",
      "sector": "pharma",
      "topics": [
        "targets"
      ],
      "title": "Open Targets 26.06：靶点评估增加细胞类型表达数据",
      "summary": "官方更新加入 PRIDE 蛋白组与单细胞 RNA 测序数据，并调整临床挖掘、Locus-to-Gene 与文献处理流程。",
      "why": "靶点优先级不只看“有没有关联”，也要看它在哪里表达。",
      "boundary": "这是数据与分析工具的更新，不等于所列靶点已通过临床验证。",
      "sources": [
        "ot-2606",
        "ot-platform"
      ],
      "kind": "update",
      "access": "公开数据",
      "published": "2026-06-24",
      "checked": "2026-09-21",
      "steps": [
        "打开官方平台并选择研究对象",
        "对照组织级与细胞类型表达",
        "记录证据来源与平台版本"
      ],
      "metrics": [
        "证据覆盖与原始来源",
        "关联与因果证据的区别",
        "数据版本及疾病标识变化"
      ],
      "featured": true,
      "tested": false
    },
